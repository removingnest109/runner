# Template file for 'runner'
pkgname=runner
version=0.1.1
revision=1
build_style=cmake
# FTXUI is not packaged in Void, so it is vendored as a second distfile and
# built from source (statically linked). Forbid network access during configure;
# the local FTXUI source dir is wired up in pre_configure() (needs $wrksrc, which
# is not yet set while the template is being sourced).
configure_args="-DFETCHCONTENT_FULLY_DISCONNECTED=ON"
makedepends="tomlplusplus-devel doctest-devel"
short_desc="TUI project script runner"
maintainer="Ethan Saenger <ethan@saenger5.com>"
license="MIT"
homepage="https://github.com/removingnest109/runner"
distfiles="https://github.com/removingnest109/runner/archive/refs/tags/v${version}.tar.gz
 https://github.com/ArthurSonzogni/FTXUI/archive/refs/tags/v6.1.9.tar.gz"
checksum="47d6c87f70bc9a5e1db3ac05ff07bedb9151c8db9bcfa9070b819a4a12e9d076
 45819c1e54914783d4a1ca5633885035d74146778a1f74e1213cdb7b76340e71"
# Both tarballs extract as siblings under a shared wrksrc; build the runner one.
create_wrksrc=yes
build_wrksrc="runner-${version}"

pre_configure() {
	# The FTXUI tarball extracts as a sibling of build_wrksrc inside $wrksrc.
	configure_args+=" -DFETCHCONTENT_SOURCE_DIR_FTXUI=${wrksrc}/FTXUI-6.1.9"
}

post_install() {
	vlicense LICENSE
}
