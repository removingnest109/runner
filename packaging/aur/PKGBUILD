# Maintainer: Ethan Saenger <ethan@saenger5.com>
pkgname=runner
pkgver=0.1.1
pkgrel=1
pkgdesc="TUI project script runner"
arch=('x86_64')
url="https://github.com/removingnest109/runner"
license=('MIT')
# FTXUI is not in the official repos; the code requires the 6.0+ API (text
# selection) and builds against both 6.x and 7.x. The main AUR ftxui package
# (currently 7.x) installs its CMake config at the standard /usr/lib/cmake/ftxui,
# which find_package(ftxui) locates with no extra hints. It ships static libs, so
# it is a build-only dep. tomlplusplus is header-only and doctest is used only by
# the test suite, so both are makedepends. gcc-libs (libstdc++) is the only
# shared-library runtime dep.
depends=('gcc-libs')
makedepends=('cmake' 'ftxui' 'tomlplusplus' 'doctest')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('47d6c87f70bc9a5e1db3ac05ff07bedb9151c8db9bcfa9070b819a4a12e9d076')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DRUNNER_BUILD_TESTS=ON \
    -Wno-dev
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
